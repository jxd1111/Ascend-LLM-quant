{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vllm-hust:contract:ascend-quant-evidence:1.1.0",
  "title": "Ascend Quantization Evaluation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "profile", "artifact", "software",
    "hardware", "workload", "results", "raw_logs"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "profile": {"enum": ["BF16", "W8A8", "W4A4", "W4A8"]},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "artifact_id", "artifact_files_sha256"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_files_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cann", "torch_npu", "vllm", "vllm_ascend", "extension"],
      "properties": {
        "cann": {"$ref": "#/$defs/nonEmptyString"},
        "torch_npu": {"$ref": "#/$defs/nonEmptyString"},
        "vllm": {"$ref": "#/$defs/nonEmptyString"},
        "vllm_ascend": {"$ref": "#/$defs/nonEmptyString"},
        "extension": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npu_model", "npu_count", "tensor_parallel", "device_ids"],
      "properties": {
        "npu_model": {"$ref": "#/$defs/nonEmptyString"},
        "npu_count": {"type": "integer", "minimum": 1},
        "tensor_parallel": {"type": "integer", "minimum": 1},
        "device_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset", "dataset_revision", "dataset_sha256", "prompts",
        "request_rate", "max_concurrency", "input_tokens", "output_tokens",
        "warmup_runs", "recorded_runs"
      ],
      "properties": {
        "dataset": {"$ref": "#/$defs/nonEmptyString"},
        "dataset_revision": {"$ref": "#/$defs/nonEmptyString"},
        "dataset_sha256": {"$ref": "#/$defs/sha256"},
        "prompts": {"type": "integer", "minimum": 1},
        "request_rate": {"type": "number", "minimum": 0},
        "max_concurrency": {"type": "integer", "minimum": 1},
        "input_tokens": {"$ref": "#/$defs/tokenCount"},
        "output_tokens": {"$ref": "#/$defs/tokenCount"},
        "warmup_runs": {"type": "integer", "minimum": 0},
        "recorded_runs": {"type": "integer", "minimum": 1}
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successful", "failed", "correctness", "quality", "throughput",
        "latency", "hbm"
      ],
      "properties": {
        "successful": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "correctness": {
          "type": "object", "additionalProperties": false,
          "required": ["passed", "metric", "value", "tolerance"],
          "properties": {
            "passed": {"type": "boolean"},
            "metric": {"$ref": "#/$defs/nonEmptyString"},
            "value": {"type": "number", "minimum": 0},
            "tolerance": {"type": "number", "minimum": 0}
          }
        },
        "quality": {
          "type": "object", "additionalProperties": false,
          "required": ["metric", "value", "bf16_delta"],
          "properties": {
            "metric": {"$ref": "#/$defs/nonEmptyString"},
            "value": {"type": "number", "minimum": 0},
            "bf16_delta": {"type": "number"}
          }
        },
        "throughput": {
          "type": "object", "additionalProperties": false,
          "required": [
            "requests_per_second", "output_tokens_per_second",
            "total_tokens_per_second"
          ],
          "properties": {
            "requests_per_second": {"type": "number", "minimum": 0},
            "output_tokens_per_second": {"type": "number", "minimum": 0},
            "total_tokens_per_second": {"type": "number", "minimum": 0}
          }
        },
        "latency": {
          "type": "object", "additionalProperties": false,
          "required": ["mean_ttft_ms", "p99_ttft_ms", "mean_tpot_ms", "p99_tpot_ms"],
          "properties": {
            "mean_ttft_ms": {"type": "number", "minimum": 0},
            "p99_ttft_ms": {"type": "number", "minimum": 0},
            "mean_tpot_ms": {"type": "number", "minimum": 0},
            "p99_tpot_ms": {"type": "number", "minimum": 0}
          }
        },
        "hbm": {
          "type": "object", "additionalProperties": false,
          "required": ["idle_mib", "loaded_mib", "peak_mib"],
          "properties": {
            "idle_mib": {"type": "number", "minimum": 0},
            "loaded_mib": {"type": "number", "minimum": 0},
            "peak_mib": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "raw_logs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tokenCount": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "string", "minLength": 1}
      ]
    }
  }
}
